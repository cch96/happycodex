{
  "schema_version": 1,
  "schemas": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "typed_anchor": {
      "type": "object"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/=+@-]*$"},
        "domain": {"type": "string", "enum": ["secret", "baseline_failure", "receipt", "other"]},
        "status": {"type": "string", "enum": ["baseline_unchanged", "resolved", "candidate_new", "unknown"]},
        "anchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "typed_anchor"},
          "uniqueItems": true
        },
        "blocker": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "class": {"type": "string", "enum": ["exhaustive_claim", "frozen_acceptance", "original_goal", "production_condition", "safety_data_integrity"]},
            "reason": {"$ref": "nonempty"}
          },
          "required": ["class", "reason"]
        }
      },
      "required": ["anchors", "blocker", "domain", "id", "status"]
    },
    "recovery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "baseline_revision": {"$ref": "git_oid"},
        "baseline_tree": {"$ref": "git_oid"},
        "current_revision": {"$ref": "git_oid"},
        "current_tree": {"$ref": "git_oid"},
        "writer": {"type": "string", "enum": ["Root"]},
        "milestone_phase": {"type": "string", "enum": ["working", "candidate_frozen", "exact_final", "closed"]},
        "next_action": {"type": "string", "enum": ["ask_user", "create_execplan", "complete_boundary_union", "create_contract_freeze_revision", "observe_red", "implement", "run_checks", "reconciliation", "freeze_candidate", "exact_final_review", "release", "none", "unknown"]},
        "pending_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["user_selection", "contract_freeze", "red_oracle", "product_edit", "checks", "reconciliation", "candidate_freeze", "exact_final_review", "release"]
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "accepted_failures": {"type": "integer", "minimum": 0},
            "marker_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "required": ["accepted_failures", "failed", "marker_ids", "passed"]
        },
        "worktree": {"type": "string", "enum": ["clean", "dirty"]},
        "live_agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "nonempty"},
              "status": {"type": "string", "enum": ["terminal"]},
              "receipt_reproduced": {"type": "boolean"}
            },
            "required": ["id", "receipt_reproduced", "status"]
          }
        },
        "marker_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "required": ["baseline_revision", "baseline_tree", "current_revision", "current_tree", "live_agents", "marker_ids", "milestone_phase", "next_action", "pending_gates", "tests", "worktree", "writer"]
    },
    "model_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualifies": {"type": "boolean"},
        "execplan_condition": {"type": "string", "enum": ["not_required", "missing", "usable", "needs_amendment"]},
        "findings": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "finding"}
        },
        "open_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["user_selection", "contract_freeze", "red_oracle", "product_edit", "checks", "reconciliation", "candidate_freeze", "exact_final_review", "release"]
          },
          "uniqueItems": true
        },
        "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason": {"$ref": "nonempty"},
        "recovery": {"$ref": "recovery"}
      },
      "required": ["evidence", "execplan_condition", "findings", "open_gates", "qualifies", "reason", "recovery"]
    },
    "case_identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/=+@-]*$"
    },
    "case_required_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualifies": {"type": "boolean"},
        "execplan_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["not_required", "missing", "usable", "needs_amendment"]},
          "uniqueItems": true
        }
      },
      "required": ["execplan_conditions", "qualifies"]
    },
    "case_required_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "case_identifier"},
        "domain": {"type": "string", "enum": ["secret", "baseline_failure", "receipt", "other"]},
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["baseline_unchanged", "resolved", "candidate_new", "unknown"]},
          "uniqueItems": true
        }
      },
      "required": ["domain", "id", "statuses"]
    },
    "case_required_blocker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "case_identifier"},
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["exhaustive_claim", "frozen_acceptance", "original_goal", "production_condition", "safety_data_integrity"]},
          "uniqueItems": true
        }
      },
      "required": ["classes", "id"]
    },
    "case_anchored_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": {"$ref": "typed_anchor"},
        "domain": {"type": "string", "enum": ["secret", "baseline_failure", "receipt", "other"]},
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["baseline_unchanged", "resolved", "candidate_new", "unknown"]},
          "uniqueItems": true
        }
      },
      "required": ["anchor", "domain", "statuses"]
    },
    "case_anchored_blocker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": {"$ref": "typed_anchor"},
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["exhaustive_claim", "frozen_acceptance", "original_goal", "production_condition", "safety_data_integrity"]},
          "uniqueItems": true
        }
      },
      "required": ["anchor", "classes"]
    },
    "case_coverage_assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {"$ref": "case_identifier"},
        "kind": {"type": "string", "enum": ["recovery", "finding", "anchored_blocker"]},
        "finding_id": {"$ref": "case_identifier"},
        "anchor": {"$ref": "typed_anchor"},
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["exhaustive_claim", "frozen_acceptance", "original_goal", "production_condition", "safety_data_integrity"]},
          "uniqueItems": true
        }
      },
      "required": ["kind", "tag"]
    },
    "case_oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_action": {"type": "string", "enum": ["ASK_USER", "RECONCILE", "IMPLEMENT", "CHECK", "FREEZE", "EXACT_FINAL", "RELEASE", "CLOSE"]},
        "required_observation": {"$ref": "case_required_observation"},
        "accepted_baseline_failures": {"type": "array", "items": {"$ref": "case_identifier"}, "uniqueItems": true},
        "required_findings": {"type": "array", "items": {"$ref": "case_required_finding"}, "uniqueItems": true},
        "required_blockers": {"type": "array", "items": {"$ref": "case_required_blocker"}, "uniqueItems": true},
        "required_blocker_classes": {
          "type": "array",
          "items": {"type": "string", "enum": ["exhaustive_claim", "frozen_acceptance", "original_goal", "production_condition", "safety_data_integrity"]},
          "uniqueItems": true
        },
        "required_anchored_findings": {"type": "array", "items": {"$ref": "case_anchored_finding"}, "uniqueItems": true},
        "required_anchored_blockers": {"type": "array", "items": {"$ref": "case_anchored_blocker"}, "uniqueItems": true},
        "coverage_assertions": {"type": "array", "items": {"$ref": "case_coverage_assertion"}, "uniqueItems": true},
        "prompt_forbidden": {"type": "array", "items": {"$ref": "nonempty"}, "uniqueItems": true}
      },
      "required": ["expected_action", "prompt_forbidden", "required_observation"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_generation": {"type": "integer", "enum": [7]},
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "covers": {"type": "array", "items": {"$ref": "nonempty"}, "minItems": 1, "uniqueItems": true},
        "prompt": {"$ref": "nonempty"},
        "fixture": {"type": "object"},
        "oracle": {"$ref": "case_oracle"}
      },
      "required": ["schema_generation", "id", "covers", "prompt", "fixture", "oracle"]
    },
    "recovery_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "namespace": {"$ref": "nonempty"},
              "revision": {"$ref": "git_oid"},
              "tree": {"$ref": "git_oid"}
            },
            "required": ["namespace", "revision", "tree"]
          }
        },
        "resource_claim": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {"type": "string", "enum": ["Root"]},
            "owner_token_sha256": {"$ref": "sha256"},
            "resources": {
              "type": "array",
              "items": {"type": "string", "pattern": "^(worktree|ref|ledger|output|activation):.+$"},
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true
            }
          },
          "required": ["owner", "owner_token_sha256", "resources"]
        },
        "selected_checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "archive": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
            "ref": {"type": ["string", "null"]}
          },
          "required": ["archive", "ref"]
        },
        "writer": {"type": "string", "enum": ["Root"]},
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accepted_failures": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "passed": {"type": "integer", "minimum": 0}
          },
          "required": ["accepted_failures", "failed", "passed"]
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "nonempty"},
              "status": {"type": "string", "enum": ["terminal"]},
              "receipt_reproduced": {"type": "boolean"}
            },
            "required": ["id", "receipt_reproduced", "status"]
          }
        },
        "gates": {"type": "array", "items": {"$ref": "nonempty"}, "minItems": 1, "uniqueItems": true}
      },
      "required": ["schema_version", "repositories", "resource_claim", "selected_checkpoint", "writer", "tests", "agents", "gates"]
    },
    "invocation_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"$ref": "nonempty"},
        "binary": {"type": "object"},
        "model": {"$ref": "nonempty"},
        "effort": {"$ref": "nonempty"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "arm": {"$ref": "nonempty"},
        "tools": {"type": "object"},
        "network": {"type": "string", "enum": ["disabled", "enabled"]},
        "hooks": {"type": "string", "enum": ["disabled", "enabled"]},
        "session": {"type": "object"}
      },
      "required": ["provider", "binary", "model", "effort", "timeout_seconds", "arm", "tools", "network", "hooks", "session"]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"$ref": "nonempty"},
            "effort": {"$ref": "nonempty"},
            "timeout_seconds": {"type": "integer", "minimum": 1}
          },
          "required": ["model", "effort", "timeout_seconds"]
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manifest_sha256": {"$ref": "sha256"}
          },
          "required": ["manifest_sha256"]
        },
        "package": {"type": "object"},
        "role": {"type": "object"},
        "public_baseline": {"type": "object"},
        "corpus": {"type": "object"},
        "holdout": {"type": "object"}
      },
      "required": ["schema_version", "settings", "engine", "package", "role", "public_baseline", "corpus", "holdout"]
    },
    "release_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "record_type": {"type": "string", "enum": ["ReleaseCandidate"]},
        "source_commit": {"$ref": "git_oid"},
        "source_tree": {"$ref": "git_oid"},
        "package_artifact_sha256": {"$ref": "sha256"},
        "package_semantic_sha256": {"$ref": "sha256"},
        "executor_role_sha256": {"$ref": "sha256"},
        "created_at": {"$ref": "nonempty"},
        "candidate_sha256": {"$ref": "sha256"}
      },
      "required": ["schema_version", "record_type", "source_commit", "source_tree", "package_artifact_sha256", "package_semantic_sha256", "executor_role_sha256", "created_at", "candidate_sha256"]
    },
    "gate_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "record_type": {"type": "string", "enum": ["GatePlan"]},
        "candidate_sha256": {"$ref": "sha256"},
        "snapshot_sha256": {"$ref": "sha256"},
        "gate": {"type": "string", "enum": ["calibration", "corpus", "holdout", "receipt", "review", "isolated_install"]},
        "created_at": {"$ref": "nonempty"},
        "profile": {"type": "object"},
        "cost_ceiling": {"type": "object"},
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "nonempty"}, "uniqueItems": true},
        "resource_digests": {"type": "array", "minItems": 1, "items": {"$ref": "sha256"}, "uniqueItems": true},
        "output": {"$ref": "nonempty"},
        "approval_request_sha256": {"$ref": "sha256"},
        "approval_content_sha256": {"$ref": "sha256"},
        "plan_sha256": {"$ref": "sha256"}
      },
      "required": ["schema_version", "record_type", "candidate_sha256", "snapshot_sha256", "gate", "created_at", "profile", "cost_ceiling", "units", "resource_digests", "output", "approval_request_sha256", "approval_content_sha256", "plan_sha256"]
    },
    "gate_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "record_type": {"type": "string", "enum": ["GateReceipt"]},
        "candidate_sha256": {"$ref": "sha256"},
        "plan_sha256": {"$ref": "sha256"},
        "gate": {"type": "string", "enum": ["calibration", "corpus", "holdout", "receipt", "review", "isolated_install"]},
        "sequence": {"type": "integer", "minimum": 0},
        "created_at": {"$ref": "nonempty"},
        "evidence_commit": {"$ref": "git_oid"},
        "unit_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "result": {"type": "string", "enum": ["succeeded", "failed"]},
        "output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "parent_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "receipt_sha256": {"$ref": "sha256"}
      },
      "required": ["schema_version", "record_type", "candidate_sha256", "plan_sha256", "gate", "sequence", "created_at", "evidence_commit", "unit_results", "result", "output_sha256", "parent_receipt_sha256", "receipt_sha256"]
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "candidate": {"type": ["object", "null"]},
        "plans": {"type": "array", "items": {"$ref": "gate_plan"}},
        "receipts": {"type": "array", "items": {"$ref": "gate_receipt"}}
      },
      "required": ["schema_version", "candidate", "plans", "receipts"]
    },
    "holdout_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "pairs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "case_path": {"$ref": "nonempty"},
              "outside_diff_boundary": {"type": "boolean"},
              "oracle_kind": {"type": "string", "enum": ["mechanical", "behavioral"]}
            },
            "required": ["id", "case_path", "outside_diff_boundary", "oracle_kind"]
          }
        }
      },
      "required": ["schema_version", "pairs"]
    }
  }
}
